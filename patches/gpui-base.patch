+    /// Group host-owned text and token edits into one undo entry.
+    /// The component continues to own history and selection restoration.
+    pub fn transact<R>(
+        &mut self,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+        edit: impl FnOnce(&mut Self, &mut Window, &mut Context<Self>) -> R,
+    ) -> R {
+        let before = self.selections.iter().copied().collect();
+        self.undo_manager.begin_transaction();
+        self.undo_manager.record_selections(before, Vec::new());
+        let result = edit(self, window, cx);
+        let after = self.selections.iter().copied().collect();
+        self.undo_manager.record_selections(Vec::new(), after);
+        self.undo_manager.commit_transaction();
+        result
+    }
