  "query": "SELECT c.id AS chat_id, c.title, p.name AS project, m.id AS message_id, m.body\nFROM chats c\nLEFT JOIN chat_settings s ON s.chat_id = c.id\nLEFT JOIN projects p ON p.id = s.project_id\nLEFT JOIN messages m ON m.chat_id = c.id\nORDER BY c.created_at DESC, c.id, m.created_at DESC, m.id;\n",
